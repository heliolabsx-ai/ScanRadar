# ---- Kite Connect (from developers.kite.trade) ----
KITE_API_KEY=xxxxxxxxxxxxxxxx
KITE_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Kite login (used only by the auto-login step, 08:55 daily) ----
KITE_USER_ID=AB1234
KITE_PASSWORD=your-kite-password
# TOTP secret: Kite > My profile > Password & security > External 2FA TOTP > "Can't scan? copy the key"
KITE_TOTP_SECRET=BASE32SECRETHERE

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=123456789

# ---- Desk (Claude) — optional; without a key the Desk tab reads "desk off" ----
# Key from console.anthropic.com (prepaid credit, auto-reload off). Daily budget in rupees is a hard stop.
ANTHROPIC_API_KEY=
DESK_MODEL=claude-opus-5-5
DESK_BUDGET_INR=100
DESK_MIN_SCORE=0
DESK_RISK_INR=2000

# ---- Infra ----
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://scanner:change-me@postgres:5432/scanner
TZ=Asia/Kolkata

# ---- Dashboard basic auth (generate hash with: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'yourpass') ----
# Keep the single quotes: the bcrypt hash contains '$' and docker compose would otherwise try to interpolate it.
DASH_USER=saurabh
DASH_HASH='$2a$14$replace-with-bcrypt-hash'
